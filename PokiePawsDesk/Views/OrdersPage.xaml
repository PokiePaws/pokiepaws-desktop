<Page x:Class="PokiePawsDesk.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      x:Name="ThisPage"
      Title="Orders" Background="{StaticResource AppBgBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Orders_Title}" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryDarkBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ComboBox x:Name="StatusFilter" Width="190"
                      SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource Orders_AllStatuses}" IsSelected="True"/>
                <ComboBoxItem Content="{DynamicResource Orders_Pending}"     Tag="PENDING"/>
                <ComboBoxItem Content="{DynamicResource Orders_InProgress}"  Tag="IN_PROGRESS"/>
                <ComboBoxItem Content="{DynamicResource Orders_Shipped}"     Tag="SHIPPED"/>
                <ComboBoxItem Content="{DynamicResource Orders_Delivered}"   Tag="DELIVERED"/>
                <ComboBoxItem Content="{DynamicResource Orders_Rejected}"    Tag="REJECTED"/>
            </ComboBox>

            <ComboBox Width="210" Margin="10,0,0,0"
                      ItemsSource="{Binding ClinicList}"
                      SelectedItem="{Binding SelectedClinicFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ClinicName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="4" Background="White" CornerRadius="16"
                BorderBrush="#e7e5e4" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding FilteredOrders}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#fafaf9"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f5f5f4"
                          SelectionMode="Single" CanUserAddRows="False"
                          RowHeight="48" FontSize="13" Foreground="#292524"
                          RowDetailsVisibilityMode="Collapsed">

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#f8fafc" Padding="16,10"
                                    BorderBrush="#e7e5e4" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="#78716c" VerticalAlignment="Top"
                                               Margin="0,0,8,0"
                                               Text="{DynamicResource Orders_Col_Description}"/>
                                    <TextBlock FontSize="12" Foreground="#292524"
                                               TextWrapping="Wrap" MaxWidth="600"
                                               Text="{Binding Description}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                    <Setter Property="Foreground" Value="#292524"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="40" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <primitives:ToggleButton
                                        Width="24" Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ExpandRow_Click"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                        <primitives:ToggleButton.Style>
                                            <Style TargetType="primitives:ToggleButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="primitives:ToggleButton">
                                                            <TextBlock x:Name="Arrow"
                                                                       Text="&#xE76C;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="#78716c"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE76D;"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </primitives:ToggleButton.Style>
                                    </primitives:ToggleButton>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding Id}" Width="55" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="ID"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding ClinicName}" Width="170">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Orders_Col_Clinic}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Orders_Col_Product}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Amount}" Width="70">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Orders_Col_Amount}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="130" SortMemberPath="Status" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Orders_Col_Status}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4" MinWidth="90"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Margin="8,0" Background="{Binding StatusBadgeBrush}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                   Foreground="{Binding StatusTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="210" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Orders_Col_Actions}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="{DynamicResource Orders_Action_Start}"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#dbeafe" Foreground="#1e40af"
                                                Visibility="{Binding PendingVisible}"
                                                Command="{Binding DataContext.StartOrderCommand, ElementName=ThisPage}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource Orders_Action_Reject}"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#fee2e2" Foreground="#991b1b"
                                                Visibility="{Binding PendingVisible}"
                                                Command="{Binding DataContext.RejectOrderCommand, ElementName=ThisPage}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{DynamicResource Orders_Action_Ship}"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#ede9fe" Foreground="#5b21b6"
                                                Visibility="{Binding InProgressVisible}"
                                                Command="{Binding DataContext.ShipOrderCommand, ElementName=ThisPage}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{DynamicResource Orders_Action_Confirm}"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#d1fae5" Foreground="#065f46"
                                                Visibility="{Binding ShippedVisible}"
                                                Command="{Binding DataContext.ConfirmOrderCommand, ElementName=ThisPage}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" BorderBrush="#e7e5e4" BorderThickness="0,1,0,0" Padding="16,10">
                    <TextBlock Text="{Binding OrderCountText}"
                               FontSize="12" Foreground="#78716c"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>