<Page x:Class="PokiePawsDesk.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Zamówienia" Background="{StaticResource AppBgBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Zamówienia" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryDarkBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ComboBox x:Name="StatusFilter" Width="190"
                      SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="Wszystkie statusy" IsSelected="True"/>
                <ComboBoxItem Content="Oczekujące"  Tag="PENDING"/>
                <ComboBoxItem Content="W trakcie"   Tag="IN_PROGRESS"/>
                <ComboBoxItem Content="Wysłane"     Tag="SHIPPED"/>
                <ComboBoxItem Content="Dostarczone" Tag="DELIVERED"/>
                <ComboBoxItem Content="Odrzucone"   Tag="REJECTED"/>
            </ComboBox>

            <ComboBox x:Name="ClinicFilter" Width="210" Margin="10,0,0,0"
                      SelectionChanged="ClinicFilter_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ClinicName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="4" Background="White" CornerRadius="16"
                BorderBrush="#e7e5e4" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" x:Name="OrdersGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#fafaf9"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f5f5f4"
                          SelectionMode="Single" CanUserAddRows="False"
                          RowHeight="48" FontSize="13" Foreground="#292524">

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                    <Setter Property="Foreground" Value="#292524"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="GABINET" Binding="{Binding ClinicName}" Width="170">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="PRODUKT" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ILOŚĆ" Binding="{Binding Amount}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Status" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4" MinWidth="90"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Margin="8,0" Background="{Binding StatusBadgeBrush}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                   Foreground="{Binding StatusTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="AKCJE" Width="210" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0">

                                        <!-- PENDING: Rozpocznij + Odrzuć -->
                                        <Button Content="Rozpocznij"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#dbeafe" Foreground="#1e40af"
                                                Visibility="{Binding PendingActionsVisibility}"
                                                Tag="{Binding}"
                                                Click="StartOrder_Click"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Odrzuć"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#fee2e2" Foreground="#991b1b"
                                                Visibility="{Binding PendingActionsVisibility}"
                                                Tag="{Binding}"
                                                Click="RejectOrder_Click"/>

                                        <!-- IN_PROGRESS: Wyślij -->
                                        <Button Content="Wyślij zamówienie"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#ede9fe" Foreground="#5b21b6"
                                                Visibility="{Binding InProgressActionsVisibility}"
                                                Tag="{Binding}"
                                                Click="ShipOrder_Click"/>

                                        <!-- SHIPPED: Potwierdź odbiór -->
                                        <Button Content="Potwierdź odbiór"
                                                Style="{StaticResource SmallActionBtn}"
                                                Background="#d1fae5" Foreground="#065f46"
                                                Visibility="{Binding ShippedActionsVisibility}"
                                                Tag="{Binding}"
                                                Click="ConfirmOrder_Click"/>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" BorderBrush="#e7e5e4" BorderThickness="0,1,0,0" Padding="16,10">
                    <TextBlock x:Name="OrderCountText" Text="Ładowanie…"
                               FontSize="12" Foreground="#78716c"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
