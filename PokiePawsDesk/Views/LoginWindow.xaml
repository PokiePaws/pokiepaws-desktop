<Window x:Class="PokiePawsDesk.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokiePaws — Logowanie"
        Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="PokiePaws" FontSize="28" FontWeight="Bold"
                       Foreground="#1A237E" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Panel pracownika magazynu" FontSize="13"
                       Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <TextBlock Text="E-mail" FontSize="13" Foreground="#333" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox" Height="38" Padding="10,8"
                     FontSize="13" BorderBrush="#CCC" BorderThickness="1"/>

            <TextBlock Text="Hasło" FontSize="13" Foreground="#333" Margin="0,16,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="38" Padding="10,8"
                         FontSize="13" BorderBrush="#CCC" BorderThickness="1"/>

            <Button Content="Zaloguj się" Height="42" Margin="0,24,0,0"
                    Background="#1A237E" Foreground="White" FontSize="14"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Click="LoginButton_Click"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>
</Window>
