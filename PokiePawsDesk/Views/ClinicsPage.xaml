<Page x:Class="PokiePawsDesk.Views.ClinicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gabinety" Background="{StaticResource AppBgBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32,32,16,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Clinics_Title}" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}"/>

            <Border Grid.Row="2" Background="White" CornerRadius="16"
                    BorderBrush="#e7e5e4" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <ListBox ItemsSource="{Binding Clinics}"
                         SelectedItem="{Binding SelectedClinic, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#f5f5f4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#fafaf9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ClinicName}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1c1917"/>
                                <Border Grid.Row="0" Grid.Column="1"
                                        CornerRadius="20" Padding="8,3"
                                        Background="{Binding StatusBadgeBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StatusTextBrush}"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding City}" FontSize="12"
                                           Foreground="#78716c"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="16,32,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Clinics_Details_Title}" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}"/>

            <Border Grid.Row="2" Background="White" CornerRadius="16"
                    BorderBrush="#e7e5e4" BorderThickness="1" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="{DynamicResource Clinics_Select}"
                               FontSize="14" Foreground="#a8a29e"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding IsClinicNotSelected, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Visibility="{Binding IsClinicSelected, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="#f5f5f4" BorderThickness="0,0,0,1"
                                Padding="0,0,0,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clinics_Detail_Name}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedClinic.ClinicName}"
                                           FontSize="15" Foreground="#1c1917"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#f5f5f4" BorderThickness="0,0,0,1"
                                Padding="0,0,0,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clinics_Detail_City}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedClinic.City}"
                                           FontSize="15" Foreground="#1c1917"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#f5f5f4" BorderThickness="0,0,0,1"
                                Padding="0,0,0,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clinics_Detail_Street}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedClinic.Street}"
                                           FontSize="15" Foreground="#1c1917"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#f5f5f4" BorderThickness="0,0,0,1"
                                Padding="0,0,0,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clinics_Detail_Hours}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedClinic.WorkingHours}"
                                           FontSize="15" Foreground="#1c1917"/>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Clinics_Detail_Status}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                                       Margin="0,0,0,6"/>
                            <Border CornerRadius="20" Padding="12,4"
                                    HorizontalAlignment="Left"
                                    Background="{Binding SelectedClinic.StatusBadgeBrush}">
                                <TextBlock Text="{Binding SelectedClinic.StatusText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding SelectedClinic.StatusTextBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Text="{DynamicResource Clinics_OrderHistory}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       Visibility="{Binding IsClinicSelected, Converter={StaticResource BoolToVis}}"/>

            <Border Grid.Row="6" Background="White" CornerRadius="16"
                    BorderBrush="#e7e5e4" BorderThickness="1"
                    Visibility="{Binding IsClinicSelected, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding ClinicOrders}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#fafaf9"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f5f5f4"
                          SelectionMode="Single" CanUserAddRows="False"
                          RowHeight="44" FontSize="13" Foreground="#292524">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Id}" Width="55">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="ID"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Clinics_Col_Product}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Amount}" Width="70">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Clinics_Col_Amount}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="130" SortMemberPath="Status">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Clinics_Col_Status}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4" MinWidth="90"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Margin="8,0" Background="{Binding StatusBadgeBrush}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                   Foreground="{Binding StatusTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>