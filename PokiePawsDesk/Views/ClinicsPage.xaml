<Page x:Class="PokiePawsDesk.Views.ClinicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gabinety" Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1A237E">
                <TextBlock Text="Gabinety" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" Margin="24,0"/>
            </Grid>

            <ListBox Grid.Row="1" x:Name="ClinicsList" Margin="8"
                     SelectionChanged="ClinicsList_SelectionChanged"
                     BorderThickness="1" BorderBrush="#DDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Name}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#1A237E"/>
                            <TextBlock Text="{Binding City}" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{Binding StatusColor}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1A237E">
                <TextBlock Text="Historia zamówień" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" Margin="24,0"/>
            </Grid>

            <DataGrid Grid.Row="1" x:Name="ClinicOrdersGrid" Margin="16"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderThickness="1" BorderBrush="#DDD"
                      RowBackground="White" AlternatingRowBackground="#F9F9F9"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Wartość" Binding="{Binding TotalPrice, StringFormat={}{0:N2} zł}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>