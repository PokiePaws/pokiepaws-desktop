<Page x:Class="PokiePawsDesk.Views.ClinicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gabinety" Background="{StaticResource AppBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32,32,16,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Gabinety" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}"/>

            <Border Grid.Row="2" Background="White" CornerRadius="16"
                    BorderBrush="#e7e5e4" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>

                <ListBox x:Name="ClinicsList"
                         SelectionChanged="ClinicsList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#f5f5f4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#fafaf9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ClinicName}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1c1917"/>
                                <Border Grid.Row="0" Grid.Column="1"
                                        CornerRadius="20" Padding="8,3"
                                        Background="{Binding StatusBadgeBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StatusTextBrush}"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding City}" FontSize="12"
                                           Foreground="#78716c"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="16,32,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Szczegóły gabinetu" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}"/>

            <Border Grid.Row="2" x:Name="DetailsCard" Background="White" CornerRadius="16"
                    BorderBrush="#e7e5e4" BorderThickness="1" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>

                <StackPanel x:Name="DetailsContent">
                    <TextBlock Text="Wybierz gabinet z listy po lewej stronie"
                               FontSize="14" Foreground="#a8a29e"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,40,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>