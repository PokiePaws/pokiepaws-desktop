<Page x:Class="PokiePawsDesk.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Katalog produktów" Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0" x:Name="DetailsPanelColumn"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1A237E">
                <TextBlock Text="Katalog produktów" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" Margin="24,0"/>
            </Grid>

            <Border Grid.Row="1" x:Name="LowStockBanner" Background="#FFF3E0"
                    BorderBrush="#FF6F00" BorderThickness="0,0,0,2"
                    Visibility="Collapsed" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠ " FontSize="14" Foreground="#E65100"/>
                    <TextBlock x:Name="LowStockText" FontSize="13" Foreground="#E65100"
                               VerticalAlignment="Center"/>
                    <Button Content="Zobacz szczegóły" Margin="16,0,0,0" Height="26"
                            Padding="10,0" Background="#E65100" Foreground="White"
                            BorderThickness="0" FontSize="12"
                            Click="LowStockDetailsButton_Click"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" x:Name="ProductsGrid" Margin="16"
                      AutoGenerateColumns="False" IsReadOnly="False"
                      Background="White" BorderThickness="1" BorderBrush="#DDD"
                      RowBackground="White" AlternatingRowBackground="#F9F9F9"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionMode="Single" CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="150"/>
                    <DataGridTextColumn Header="Stan magazynowy" Binding="{Binding Stock}" Width="130"/>
                    <DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat={}{0:N2} zł}" Width="100"/>
                    <DataGridTemplateColumn Header="Status" Width="120" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StockColor}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Padding="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,8" VerticalAlignment="Center">
                <Button Content="➕ Dodaj produkt" Height="36" Width="140"
                        Background="#1A237E" Foreground="White" BorderThickness="0"
                        FontSize="13" Margin="0,0,8,0" Click="AddProductButton_Click"/>
                <Button Content="🗑 Usuń produkt" Height="36" Width="140"
                        Background="#B71C1C" Foreground="White" BorderThickness="0"
                        FontSize="13" Click="DeleteProductButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#E65100">
                <TextBlock Text="⚠ Niski stan magazynowy" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0"/>
                <Button Content="✕" HorizontalAlignment="Right" Margin="0,0,16,0"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="16" Click="ClosePanelButton_Click"/>
            </Grid>

            <DataGrid Grid.Row="1" x:Name="LowStockGrid" Margin="16"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderThickness="1" BorderBrush="#DDD"
                      RowBackground="White" AlternatingRowBackground="#F9F9F9"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Stan" Binding="{Binding Stock}" Width="60"/>
                    <DataGridTextColumn Header="Próg" Binding="{Binding LowStockThreshold}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>