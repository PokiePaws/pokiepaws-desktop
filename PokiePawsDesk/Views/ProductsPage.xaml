<Page x:Class="PokiePawsDesk.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="clr-namespace:PokiePawsDesk.Core"
      x:Name="ThisPage"
      Title="Products" Background="{StaticResource AppBgBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <core:PriceConverter x:Key="PriceConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0" x:Name="DetailsPanelColumn"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Products_Title}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" x:Name="LowStockIndicator"
                        Background="#fef3c7" CornerRadius="20" Padding="14,6"
                        BorderBrush="#fbbf24" BorderThickness="1"
                        Visibility="{Binding LowStockVisible, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="LowStockIndicator_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Foreground="#92400e"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LowStockIndicatorText"
                                   Text="{Binding LowStockText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#92400e" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" CornerRadius="16"
                    BorderBrush="#e7e5e4" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <DataGrid x:Name="ProductsGrid"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserSortColumns="True"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#fafaf9"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f5f5f4"
                          SelectionMode="Single" CanUserAddRows="False"
                          RowHeight="44" FontSize="13" Foreground="#292524"
                          RowEditEnding="ProductsGrid_RowEditEnding">

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                    <Setter Property="Foreground" Value="#292524"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding AssortmentDescription}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#f0f9ff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Binding="{Binding Id}" Width="50" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="ID"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Name}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="*" SortMemberPath="Category">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Category}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Category}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              Text="{Binding Category, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.AvailableCategories, ElementName=ThisPage}"
                                              VerticalAlignment="Center" Margin="4,0"
                                              BorderThickness="0" Background="Transparent"
                                              FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="70">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Amount}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="110" SortMemberPath="Unit">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Unit}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Unit}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              Text="{Binding Unit, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.AvailableUnits, ElementName=ThisPage}"
                                              VerticalAlignment="Center" Margin="4,0"
                                              BorderThickness="0" Background="Transparent"
                                              FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding Price, Converter={StaticResource PriceConverter}, UpdateSourceTrigger=PropertyChanged}" Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Price}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="120" SortMemberPath="ExpiryDate">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_ExpiryDate}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpiryDate, StringFormat={}{0:dd.MM.yyyy}}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" Margin="2,0"
                                                BorderThickness="0" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="110" IsReadOnly="True" SortMemberPath="Amount">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Status}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4" MinWidth="80"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Margin="8,0" Background="{Binding StockBadgeBrush}">
                                        <TextBlock Text="{Binding StockStatus}" FontSize="11"
                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                   Foreground="{Binding StockTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Products_Add}" Style="{StaticResource PrimaryBtn}"
                            Height="38" Padding="20,0" Margin="0,0,10,0"
                            Click="AddProductButton_Click"/>
                    <Button Content="{DynamicResource Products_Delivery}" Style="{StaticResource PrimaryBtn}"
                            Height="38" Padding="20,0" Margin="0,0,10,0"
                            Background="#10b981"
                            Click="DeliveryButton_Click"/>
                    <Button Content="{DynamicResource Products_Delete}" Style="{StaticResource DangerBtn}"
                            Height="38" Padding="20,0"
                            Click="DeleteProductButton_Click"/>
                </StackPanel>

                <Border x:Name="InlineNotification" Visibility="Collapsed"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Background="#fef3c7" BorderBrush="#fbbf24" BorderThickness="1"
                        CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" Foreground="#92400e"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="InlineNotificationText"
                                   FontSize="12" Foreground="#92400e"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="White"
                BorderBrush="#e7e5e4" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,16,16,16"
                        BorderBrush="#e7e5e4" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#92400e" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Products_LowStock_Title}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#92400e"/>
                            <TextBlock x:Name="LowStockSubtitle"
                                       Text="{Binding LowStockSubtitle}"
                                       FontSize="11" Foreground="#a8a29e"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#a8a29e" Cursor="Hand" VerticalAlignment="Center"
                                Click="ClosePanelButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#fef9ec" Padding="16,10"
                        BorderBrush="#fde68a" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource Products_LowStock_Info}"
                               FontSize="11" Foreground="#92400e" TextWrapping="Wrap"/>
                </Border>

                <DataGrid Grid.Row="2" x:Name="LowStockGrid"
                          ItemsSource="{Binding LowStockProducts}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#fffbf0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f5f5f4"
                          CanUserAddRows="False" RowHeight="44" FontSize="13">

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Name}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="16,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="80" SortMemberPath="Amount">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Products_Col_Amount}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Margin="8,0" Background="{Binding StockBadgeBrush}">
                                        <TextBlock Text="{Binding Amount}" FontSize="12"
                                                   FontWeight="Bold" TextAlignment="Center"
                                                   Foreground="{Binding StockTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>