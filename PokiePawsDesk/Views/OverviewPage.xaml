<Page x:Class="PokiePawsDesk.Views.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Przegląd" Background="{StaticResource AppBgBrush}"
      FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <TextBlock Text="Przegląd" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Witaj z powrotem. Oto aktualny stan magazynu."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PendingCount" Text="0" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Oczekujące zamówienia" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#fff7ed" Width="52" Height="52"
                                CornerRadius="14" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA8F;"
                                       FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#f59e0b"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProductCount" Text="0" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Produkty w katalogu" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#eff6ff" Width="52" Height="52"
                                CornerRadius="14" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;"
                                       FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#3b82f6"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Background="White" CornerRadius="16" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="LowStockCount" Text="0" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Niski stan magazynowy" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#fef2f2" Width="52" Height="52"
                                CornerRadius="14" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;"
                                       FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#dc2626"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Background="White" CornerRadius="16" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ClinicCount" Text="0" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Aktywne gabinety" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#f0fdf4" Width="52" Height="52"
                                CornerRadius="14" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEAF3;"
                                       FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#10b981"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <Border Padding="24,18,24,14" BorderBrush="#e7e5e4" BorderThickness="0,0,0,1">
                        <TextBlock Text="Nowe zamówienia" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <DataGrid x:Name="RecentOrdersGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              CanUserSortColumns="True"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#f5f5f4"
                              HeadersVisibility="Column" Background="Transparent"
                              RowBackground="White" AlternatingRowBackground="#fafaf9"
                              RowHeight="44" FontSize="13" Foreground="#292524">

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#f0f9ff"/>
                                        <Setter Property="Foreground" Value="#292524"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#f0f9ff"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GABINET" Binding="{Binding ClinicName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="24,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PRODUKT" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ILOŚĆ" Binding="{Binding Amount}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,4" MinWidth="90"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Margin="8,0"
                                                Background="{Binding StatusBadgeBrush}">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                       FontWeight="SemiBold" TextAlignment="Center"
                                                       Foreground="{Binding StatusTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>