<Window x:Class="PokiePawsDesk.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokiePaws"
        Icon="/Assets/logo.png"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        Closed="Window_Closed">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,14" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="28" Height="28"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Pokie" Foreground="#d4585b" FontSize="18" FontWeight="Bold"/>
                        <Run Text="Paws" Foreground="#335f7d" FontSize="18" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="1" Margin="12,0,12,14"
                        Background="#ecfdf5" CornerRadius="10" Padding="12,8"
                        BorderBrush="#a7f3d0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ROLA" FontSize="9" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="Pracownik Magazynu" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="12,0">
                    <Button x:Name="BtnOverview" Style="{StaticResource NavBtnActive}"
                            Click="BtnOverview_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"
                                       FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Przegląd" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnOrders" Style="{StaticResource NavBtn}"
                            Click="BtnOrders_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;"
                                       FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Zamówienia" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border x:Name="OrdersBadge" Background="#dc2626" CornerRadius="10"
                                    Padding="6,1" Margin="8,0,0,0" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="OrdersBadgeText" Text="1" FontSize="10"
                                           FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnProducts" Style="{StaticResource NavBtn}"
                            Click="BtnProducts_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;"
                                       FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Katalog produktów" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClinics" Style="{StaticResource NavBtn}"
                            Click="BtnClinics_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEAF3;"
                                       FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Gabinety" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                                     Fill="#10b981" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionText" Text="Online"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="UserNameText" Text="Ładowanie..."
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,8,0,2"/>
                        <TextBlock x:Name="UserEmailText" Text=""
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>

                        <Button Style="{StaticResource GhostBtn}" Content="Wyloguj się"
                                HorizontalAlignment="Stretch"
                                Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="NotificationBanner" Grid.Row="0"
                    Background="#dbeafe" Padding="16,10"
                    BorderBrush="#bfdbfe" BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F2;"
                                   FontSize="14" Foreground="#1e40af"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="NotificationText"
                                   Text="Nowe zamówienie od gabinetu!"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1e40af" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#1e40af" Cursor="Hand"
                            Click="DismissNotification_Click"/>
                </Grid>
            </Border>

            <Frame Grid.Row="1" x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>