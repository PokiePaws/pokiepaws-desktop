<Window x:Class="PokiePawsDesk.Views.DeliveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="Auto"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="16"
            BorderBrush="#e7e5e4" BorderThickness="1"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.14" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="28,24,28,28">

            <TextBlock x:Name="TitleText"
                       FontSize="17" FontWeight="SemiBold" Foreground="#1c1917"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="ProductLabelText"
                       FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                       Margin="0,0,0,4"/>

            <TextBlock x:Name="ProductNameText"
                       FontSize="14" Foreground="#1c1917"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="QtyLabelText"
                       FontSize="11" FontWeight="SemiBold" Foreground="#78716c"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="QuantityBox"
                     FontSize="15"
                     PreviewTextInput="QuantityBox_PreviewTextInput"
                     KeyDown="QuantityBox_KeyDown"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn"
                        Style="{StaticResource GhostBtn}"
                        Width="100" Margin="0,0,10,0"
                        Click="CancelBtn_Click"/>
                <Button x:Name="ConfirmBtn"
                        Style="{StaticResource PrimaryBtn}"
                        Width="120"
                        Click="ConfirmBtn_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>